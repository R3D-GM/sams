generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum Role {
  SUPER_ADMIN
  TEACHER
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  users     User[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A logged-in account: SUPER_ADMIN (no department, sees everything)
/// or TEACHER (scoped to one department).
model User {
  id           String      @id @default(uuid())
  username     String      @unique
  password     String // bcrypt hash
  fullName     String      @default("User")
  email        String?
  role         Role        @default(TEACHER)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
}

model Student {
  id                   String        @id @default(uuid())
  /// Human readable auto generated id e.g. STU-00001
  studentId            String        @unique
  fullName             String
  phone                String        @unique
  department           Department    @relation(fields: [departmentId], references: [id])
  departmentId         String
  /// Free-text university department captured at registration (e.g. "Software Engineering").
  /// Not a scoping/login department — just metadata for later analytics filtering.
  universityDepartment String?
  batch                String
  gender               Gender        @default(OTHER)
  email                String?
  status               StudentStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  attendances Attendance[]

  @@index([departmentId])
  @@index([batch])
  @@index([fullName])
  @@index([universityDepartment])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Session date, always stored normalised to midnight UTC
  date      DateTime
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  /// One record per student per session date
  @@unique([studentId, date])
  @@index([date])
}
